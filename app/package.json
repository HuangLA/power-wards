{
  "name": "power-wards-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "local": "npm run build && node local/server.mjs",
    "build": "tsc -b && vite build",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "preview": "node local/server.mjs --port 4173",
    "test": "vitest run && node --test local/server.node-test.mjs",
    "typecheck": "tsc -b --noEmit",
    "tiles": "node scripts/generate-tiles.mjs",
    "electron": "electron .",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:electron": "node scripts/verify-electron.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "playwright": "^1.63.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
